---
type Props = {
  id: string;
  title: string;
  tags?: string[];
};

const { id, title, tags = [] } = Astro.props;

type SourceVisual = {
  match: string[];
  files: string[];
  label: string;
  source: string;
};

// 文章配图全部来自 Obsidian 保存的 LinuxDo 原帖或回复楼层图片。
const visualMap: SourceVisual[] = [
  {
    match: ["ai-collaboration-workflow"],
    files: [
      "ai-collaboration-01.jpeg",
      "ai-collaboration-02.jpeg",
      "ai-collaboration-03.jpeg",
      "ai-collaboration-04.jpeg",
    ],
    label: "原帖图片：AI 协作从日常任务进入可复用工作流",
    source: "LinuxDo 原帖 #2059718（含回复图片）",
  },
  {
    match: ["ai-assisted-research-workflow", "choosing-ai-for-research"],
    files: ["ai-research-01.png"],
    label: "原帖图片：论文初稿讨论中的实际页面",
    source: "LinuxDo 原帖 #2772620",
  },
  {
    match: ["deepseek-vision-workflow"],
    files: [
      "deepseek-vision-01.png",
      "deepseek-vision-02.png",
      "deepseek-vision-03.png",
    ],
    label: "原帖图片：DeepSeek 看图的代理、输入与配置截图",
    source: "LinuxDo 原帖 #2713829",
  },
  {
    match: ["pi-agent-architecture-notes"],
    files: [
      "pi-agent-01.jpeg",
      "pi-agent-02.jpeg",
      "pi-agent-03.jpeg",
      "pi-agent-04.png",
    ],
    label: "原帖图片：PiAgent 的配置、工作台和回复截图",
    source: "LinuxDo 原帖 #2571534（含引用回复图片）",
  },
  {
    match: ["product-skill-design"],
    files: ["product-skill-01.png", "product-skill-02.png"],
    label: "原帖图片：产品经理 Skill 推荐项目截图",
    source: "LinuxDo 原帖 #2635180（含回复图片）",
  },
  {
    match: ["wechat-ai-project-notes"],
    files: ["wechat-ai-01.jpeg", "wechat-ai-02.jpeg"],
    label: "原帖图片：微信 Hook 接收消息的代码截图",
    source: "LinuxDo 原帖 #2758878",
  },
  {
    match: ["qwen-local-inference-notes"],
    files: ["qwen-inference-01.png", "qwen-inference-02.png"],
    label: "原帖图片：Qwen 27B 推理速度和显卡运行状态",
    source: "LinuxDo 原帖 #2774365",
  },
  {
    match: ["glasses-purchase-framework"],
    files: [
      "glasses-01.png",
      "glasses-02.png",
      "glasses-03.jpeg",
      "glasses-04.png",
    ],
    label: "原帖附件：镜框尺寸、参数和镜片选择讨论",
    source: "LinuxDo 原帖 #1116647（含回复附件）",
  },
  {
    match: ["long-form-video-pipeline"],
    files: ["long-video-01.png", "long-video-02.png", "long-video-03.png"],
    label: "原帖图片：Remotion 长视频制作和示例截图",
    source: "LinuxDo 原帖 #2652859",
  },
  {
    match: ["research-resource-map"],
    files: [
      "research-library-01.jpeg",
      "research-library-02.png",
      "research-library-03.png",
    ],
    label: "原帖与回复图片：科研资源索引、论文插图和一站式写作工具示例",
    source: "LinuxDo 原帖 #1417107（含回复楼层图片）",
  },
  {
    match: ["cinematic-image-workflow"],
    files: [
      "cinematic-image-01.jpeg",
      "cinematic-image-02.jpeg",
      "cinematic-image-03.jpeg",
      "cinematic-image-04.jpeg",
    ],
    label: "原帖与回复图片：电影感生图样例和评论区同提示词对比",
    source: "LinuxDo 原帖 #2491698（含回复楼层图片）",
  },
  {
    match: ["tailscale-and-proxy-routing"],
    files: ["tailscale-01.png"],
    label: "回复图片：Clash 与 Tailscale 配置示例",
    source: "LinuxDo 原帖 #2817884 的回复楼层",
  },
];

const normalized = `${id} ${tags.join(" ")}`.toLowerCase();
const visual = visualMap.find(item =>
  item.match.some(keyword => normalized.includes(keyword))
);
---

{
  visual && (
    <figure class="article-visual not-prose" aria-label={visual.label}>
      <div class="article-visual-grid">
        {visual.files.map(file => (
          <img
            src={`${import.meta.env.BASE_URL}media/posts/${file}`}
            alt={`${title}：${visual.label}`}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <figcaption>
        {visual.label}。来源：{visual.source}。
      </figcaption>
    </figure>
  )
}
