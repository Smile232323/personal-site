const normalized = `${id} ${tags.join(" ")}`.toLowerCase();
const visual = visualMap.find(item =>
  item.match.some(keyword => normalized.includes(keyword))
);
// 正文已在对应段落中引用整组原图时，不再在文章顶部重复展示。
const hasInlineVisuals = visual?.files.every(file =>
  body.includes(`/media/posts/${file}`)
);
---

{
  visual && !hasInlineVisuals && (
    <figure class="article-visual not-prose" aria-label={visual.label}>
      <div class="article-visual-grid">
        {visual.files.map(file => (
          <img
            src={`${import.meta.env.BASE_URL}media/posts/${file}`}
            alt={`${title}：${visual.label}`}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
      <figcaption>
        {visual.label}。来源：{visual.source}。
      </figcaption>
    </figure>
  )
}
