---
type Props = {
  source?: string;
  sourceDate?: Date;
  curatedAt?: Date;
  sourceNote?: string;
};

const { source, sourceDate, curatedAt, sourceNote } = Astro.props;
---

{
  (source || sourceDate || curatedAt || sourceNote) && (
    <aside
      data-pagefind-ignore
      class="border-border bg-muted/30 my-6 rounded border p-4 text-sm"
    >
      <p class="font-medium">资料说明</p>
      {sourceNote && <p class="mt-1">{sourceNote}</p>}
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 opacity-75">
        {sourceDate && (
          <span>原始资料：{sourceDate.toLocaleDateString("zh-CN")}</span>
        )}
        {curatedAt && (
          <span>整理时间：{curatedAt.toLocaleDateString("zh-CN")}</span>
        )}
        {source && (
          <a class="text-accent underline" href={source} rel="noreferrer">
            查看来源
          </a>
        )}
      </div>
    </aside>
  )
}
