---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { useTranslations } from "@/i18n";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);
const publications = (await getCollection("publications"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const yearDiff = (b.data.year ?? 0) - (a.data.year ?? 0);
    return yearDiff || a.data.title.localeCompare(b.data.title, "zh-CN");
  });
---

<Layout
  title={`${t.pages.publicationsTitle} | ${config.site.title}`}
  description={t.pages.publicationsDesc}
>
  <Header />
  <Breadcrumb />
  <Main
    pageTitle={t.pages.publicationsTitle}
    pageDesc={t.pages.publicationsDesc}
  >
    <div data-pagefind-body>
      <ul class="space-y-6">
        {
          publications.map(publication => (
            <li class="border-border border-b pb-5">
              <a
                class="text-accent text-xl font-medium hover:underline"
                href={`${import.meta.env.BASE_URL}publications/${publication.id}/`}
              >
                {publication.data.title}
              </a>
              <p class="mt-2">{publication.data.description}</p>
              {(publication.data.venue || publication.data.year) && (
                <p class="text-sm opacity-70">
                  {[publication.data.venue, publication.data.year]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Main>
  <Footer />
</Layout>
