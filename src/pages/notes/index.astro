---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";

const notes = (await getCollection("notes"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => {
    const aTime = new Date(
      a.data.modDatetime ?? a.data.pubDatetime ?? a.data.sourceDate ?? 0
    ).getTime();
    const bTime = new Date(
      b.data.modDatetime ?? b.data.pubDatetime ?? b.data.sourceDate ?? 0
    ).getTime();
    return bTime - aTime || a.data.title.localeCompare(b.data.title, "zh-CN");
  });
---

<Layout
  title="笔记 | Smile232323 · Notes & Works"
  description="技术笔记与研究记录。"
>
  <Header />
  <Main pageTitle="笔记" pageDesc="技术笔记、研究记录和可复用的解决方案。">
    <div data-pagefind-body>
      <ul class="space-y-6">
        {
          notes.map(note => (
            <li class="border-border border-b pb-5">
              <a
                class="text-accent text-xl font-medium hover:underline"
                href={`${import.meta.env.BASE_URL}notes/${note.id}/`}
              >
                {note.data.title}
              </a>
              {note.data.description && (
                <p class="mt-2">{note.data.description}</p>
              )}
              {note.data.tags.length > 0 && (
                <p class="text-sm opacity-70">{note.data.tags.join(" · ")}</p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </Main>
  <Footer />
</Layout>
