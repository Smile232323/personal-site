---
import { getEntry, render } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const resume = await getEntry("pages", "resume");

if (!resume) {
  throw new Error("Missing content entry: `resume.md` or `resume.mdx`");
}

const { Content } = await render(resume);
const { summary, skills, experience, education } = resume.data;
---

<Layout
  title={`${resume.data.title} | ${config.site.title}`}
  description={resume.data.description}
  ogImage={resume.data.ogImage}
  canonicalURL={resume.data.canonicalURL}
>
  <Header />
  <Breadcrumb />
  <Main pageTitle={resume.data.title} pageDesc={resume.data.description}>
    <div data-pagefind-body>
      <section
        class="border-border bg-muted/20 mb-10 rounded-lg border p-4 sm:p-6"
      >
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div>
            <h2 class="m-0 text-xl font-semibold">简历 PDF</h2>
            <p class="text-muted-foreground mt-1 text-sm">
              可直接在线预览，也可以在新窗口打开。
            </p>
          </div>
          <div class="flex flex-wrap gap-3 text-sm">
            <a
              class="border-border hover:border-accent hover:text-accent rounded border px-3 py-2 transition-colors"
              href={`${import.meta.env.BASE_URL}documents/resume-public.pdf`}
              target="_blank"
              rel="noreferrer"
            >
              打开 PDF
            </a>
            <a
              class="bg-accent text-accent-foreground hover:bg-accent/90 rounded px-3 py-2 transition-colors"
              href={`${import.meta.env.BASE_URL}documents/self-introduction.pdf`}
              target="_blank"
              rel="noreferrer"
            >
              自我介绍 PDF
            </a>
          </div>
        </div>
        <object
          data={`${import.meta.env.BASE_URL}documents/resume-public.pdf`}
          type="application/pdf"
          aria-label="简历 PDF 预览"
          class="mt-5 h-[720px] w-full rounded border bg-white"
        >
          <p class="text-sm">
            当前浏览器不支持内嵌预览，请
            <a
              class="text-accent underline"
              href={`${import.meta.env.BASE_URL}documents/resume-public.pdf`}
              target="_blank"
              rel="noreferrer"
            >
              打开简历 PDF
            </a>
            。
          </p>
        </object>
      </section>

      {summary && <p class="lead text-lg">{summary}</p>}

      {
        skills.length > 0 && (
          <section class="mt-8">
            <h2>技能</h2>
            <ul class="mt-3 flex flex-wrap gap-2">
              {skills.map(skill => (
                <li class="border-border rounded border px-3 py-1 text-sm">
                  {skill}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        experience.length > 0 && (
          <section class="mt-8">
            <h2>经历</h2>
            <ul class="mt-3 list-disc space-y-2 ps-5">
              {experience.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      {
        education.length > 0 && (
          <section class="mt-8">
            <h2>教育</h2>
            <ul class="mt-3 list-disc space-y-2 ps-5">
              {education.map(item => (
                <li>{item}</li>
              ))}
            </ul>
          </section>
        )
      }

      <div class="app-prose mt-8">
        <Content />
      </div>
    </div>
  </Main>
  <Footer />
</Layout>
