---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";

const projects = (await getCollection("projects"))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title, "zh-CN"));
---

<Layout
  title="作品 | Smile232323 · Notes & Works"
  description="项目、作品与实验。"
>
  <Header />
  <Main pageTitle="作品" pageDesc="项目、实验和可公开展示的工作。">
    <div data-pagefind-body>
      <ul class="grid gap-6 sm:grid-cols-2">
        {
          projects.map(project => (
            <li class="border-border rounded border p-5">
              <a
                class="text-accent text-xl font-medium hover:underline"
                href={`${import.meta.env.BASE_URL}projects/${project.id}/`}
              >
                {project.data.title}
              </a>
              <p class="mt-2">{project.data.description}</p>
              <p class="mt-3 text-sm opacity-70">
                {project.data.stack.join(" · ")}
              </p>
              <div class="mt-4 flex gap-4 text-sm">
                {project.data.repo && (
                  <a class="underline" href={project.data.repo}>
                    GitHub
                  </a>
                )}
                {project.data.demo && (
                  <a class="underline" href={project.data.demo}>
                    Demo
                  </a>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </Main>
  <Footer />
</Layout>
